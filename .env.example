# 智能工厂设备运维管理平台 - 环境变量模板
# 复制为 .env.development 并填入真实值(.env.development 已被 .gitignore 排除,不会进版本)

# 应用名(显示在侧边栏顶部)
VITE_APP_NAME=智能工厂设备运维管理平台

# 天行数据 API key
# 申请地址:https://www.tianapi.com → 注册 → 控制台 → 我的接口 → 申请「天气预报」→ 我的密钥
#
# 三种填法:
# 1) 留空或者保持 your_key_here 占位:看板天气走内置「离线演示数据」,
#    不发起网络请求、不会出现 240/230 报错,演示(断网/没账号)也能撑住
# 2) 填真实 key:走天行实时接口,页面无「离线演示」标记
# 3) key 失效:自动降级为离线演示数据,并在页面顶部标注原因
VITE_TIANAPI_KEY=your_key_here
